# Discord Bot Configuration
DISCORD_TOKEN=put_your_discord_bot_token_here
CLIENT_ID=put_your_application_id_here
GUILD_ID=

# Spotify API Configuration
# ملاحظة: مفاتيح Spotify مدمجة افتراضياً في config.js (من elminyawe)
# لا تحتاج لإضافتها هنا إلا إذا أردت استخدام مفاتيحك الخاصة
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US

# Genius API Configuration (optional - for lyrics)
GENIUS_CLIENT_ID=
GENIUS_CLIENT_SECRET=

# Bot Settings
# ملاحظة: الكود يفرض "Dev : ELMINYAWE" بشكل صلب ولا يقرأ هذه القيمة من env
# هذه القيمة هنا فقط للتوافق مع الإصدارات السابقة، تجاهلها
STATUS=Dev : ELMINYAWE
EMBED_COLOR=#FF6B6B
DEFAULT_VOLUME=100
MAX_QUEUE_SIZE=100
MAX_PLAYLIST_SIZE=50

# Hybrid Commands (prefix + slash)
PREFIX=!
ENABLE_PREFIX=true
ENABLE_SLASH=true
PREFIX_ADMIN_ONLY=false

# Sharding
TOTAL_SHARDS=auto
SHARD_MODE=process
SHARD_RESPAWN=true

# Resilience (Edge Cases)
EMPTY_VOICE_TIMEOUT_MS=300000
RECONNECT_TIMEOUT_MS=10000
MAX_RECONNECT_ATTEMPTS=3
CLEANUP_DELAY_MS=2000
AUTO_RESUME=true
PERSIST_PLAYER_STATE=true
STATE_PERSIST_DELAY_MS=3000
# الحصة القصوى لمجلد كاش الصوت بالميجابايت (يحمي القرص من الامتلاء بسبب preload)
MAX_CACHE_SIZE_MB=1500

# YouTube / yt-dlp
YT_CONNECTION_MODE=auto
YT_PLAYER_CLIENTS=mweb,web_safari,tv
YT_JS_RUNTIMES=deno
YT_AUTO_COOKIES_FILE=./cookies/cookies.txt
YT_PROXY=socks5://127.0.0.1:1080
YT_COOKIES_INTERVAL_SEC=21600

# youtube-dl-exec: use Python yt-dlp wrapper (loads bgutil plugin)
YOUTUBE_DL_DIR=/usr/local/bin
YOUTUBE_DL_FILENAME=yt-dlp-py

# elminyawe
ELMINYAWE_ENABLED=true
BGUTIL_PORT=4416
WARP_SOCKS_PORT=1080

# بروكسيات SOCKS5 اختيارية للتحميل (فارغة = اتصال مباشر فقط — يُنصح تركها فارغة)
# SOCKS5_PROXIES=socks5://user:pass@host:port,socks5://host2:port
SOCKS5_PROXIES=

# ═══ v26.7: Stability Manager (التشغيل الدائم) ═══
# حد التحذير للذاكرة بالميجابايت — عند تجاوزه تُنظف الكاشات تلقائياً
MEM_WARN_MB=600
# حد الخطر — عند تجاوزه يُعاد تشغيل البوت رشيقاً (supervisord يعيده خلال ~15 ثانية)
MEM_CRITICAL_MB=1200
# إعادة التشغيل الرشيقة عند خطر الذاكرة (1=مفعّل | 0=معطل)
AUTO_RESTART_ON_OOM=1
# إعادة تشغيل مجدولة اختيارية بالساعات (0=معطلة | 168=أسبوعياً)
# يُنصح بتفعيلها 168 للبوتات طويلة التشغيل — إعادة تشغيل رشيقة أسبوعياً
# تحافظ على الذاكرة نظيفة والجلسات تُستعاد تلقائياً بعد الإقلاع
AUTO_RESTART_HOURS=0
# عمر ملفات كاش الصوت بالساعات قبل الحذف التلقائي (نظافة القرص الدورية)
AUDIO_CACHE_MAX_AGE_H=24

# ═══ v26.8: Music Card (ثيم musicard Ease) ═══
# ثيم البطاقة: ease (فاتح — مثل معاينة ريبو musicard) | ease-dark (داكن)
# اتركه فارغاً أو غير موجود لاستخدام الثيم الفاتح الافتراضي
MUSIC_CARD_THEME=ease
